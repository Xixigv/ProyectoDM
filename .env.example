# Copia este archivo como .env y cambia los valores. .env NO se sube a GitHub (.gitignore).

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=orders-stream

# --- MongoDB (usuario root del contenedor de docker-compose) ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change_me

# URI que usan el consumidor de Spark y los scripts de validación.
# Si usas MongoDB Atlas, pega aquí tu cadena mongodb+srv://...
MONGODB_URI=mongodb://admin:change_me@localhost:27017/?authSource=admin
MONGODB_DATABASE=qcommerce
